# Copy to .env next to docker-compose.yml. The stack does not start without DB_PASSWORD.

# Release to run (https://github.com/billery-app/billery/releases). Pin a version for a real
# install; `latest` follows every release.
BILLERY_VERSION=latest

# Database password: openssl rand -base64 24
DB_PASSWORD=

# Encrypts the passwords of the mail accounts (Einstellungen → Mail-Einstellungen):
# openssl rand -base64 32. Keep it safe: a new key makes the stored passwords unreadable.
BILLERY_SECRETS_KEY=

# Host interface and port. Loopback = only a proxy on this host reaches the app (recommended:
# it has no login of its own). 0.0.0.0 = every interface of the host: whoever reaches the host
# reaches the app without a login, so only behind a firewall that keeps it off the internet.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Public demo (docs/operations/demo.md); never for a real install.
# BILLERY_DEMO=true
# LOAD_DEMO_DATA=true

# Resources (the Java heap takes 75 % of BACKEND_MEMORY_LIMIT).
# BACKEND_MEMORY_LIMIT=1g
# BACKEND_CPUS=2
# DB_MEMORY_LIMIT=512m
