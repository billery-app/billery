# Billery SaaS: configuration. Copy to .env (or run ./generate-secrets.sh, which does that and fills
# the secrets), then fill in the provider values below. Keep .env readable only by you (chmod 600);
# it is not committed. Runbook: docs/operations/saas-deployment.md

# --- Release ------------------------------------------------------------------------------------
# The version of the image ghcr.io/billery-app/billery-saas to run, as in the GitHub release (without
# the "v"), for example 0.1.1. Pin it; "latest" moves.
BILLERY_VERSION=

# --- Where the application is reachable -----------------------------------------------------------
# The host name (no scheme), for example app.example.com. Only the optional Caddy uses it
# (docker compose --profile proxy up -d), which gets the certificate for it; DNS must point here.
# Leave it empty if your own proxy is in front and you do not use the profile. check.sh uses it as
# the public URL (https://<domain>).
BILLERY_DOMAIN=

# The backend listens on this address and port of the host. 127.0.0.1 = only a reverse proxy on
# this host can reach it (the Caddy of the compose file counts as one: it uses the compose network).
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# --- Identity provider (any OpenID Connect provider) ------------------------------------------
# The application stores no passwords and knows the provider only through these values.
# The issuer URL exactly as the provider writes it in the "iss" claim of its tokens, including a
# trailing slash if it has one (authentik: https://auth.example.com/application/o/<slug>/). Comma
# separated for more than one provider. The backend must be able to reach
# <issuer>/.well-known/openid-configuration over HTTPS.
BILLERY_SECURITY_ISSUERS=
# The value of the "aud" claim of the ACCESS tokens. Required: a token for another application of
# the same provider is refused. Often the client id.
BILLERY_SECURITY_AUDIENCE=
# The public client of the single-page app at the provider (authorization code with PKCE).
BILLERY_OIDC_CLIENT_ID=
# Optional. Which provider the app signs in at (default: the first issuer) and the requested scopes
# (offline_access lets the provider issue refresh tokens for the silent renewal).
BILLERY_OIDC_ISSUER=
BILLERY_OIDC_SCOPE=openid profile email offline_access

# --- Secrets (./generate-secrets.sh fills these, never commit them) --------------------------------
# The PostgreSQL bootstrap account. Only the init script and the backup use it.
POSTGRES_ADMIN_PASSWORD=
# billery_owner: owns the tables, runs the schema migrations at start.
DB_MIGRATION_PASSWORD=
# billery_login: what the application connects as (row-level security binds this role).
DB_PASSWORD=
# Signs the URLs of uploaded files. At least 32 characters. Keep it stable.
BILLERY_FILES_SECRET=

# --- Optional ---------------------------------------------------------------------------------
# Uploaded files (logos). local (default): the uploads volume, enough for one backend instance.
# s3: a private bucket of any S3-compatible store (AWS S3, Supabase Storage, SeaweedFS, ...), for
# several instances without a shared disk; browsers never talk to the bucket. Empty endpoint = AWS;
# empty keys = the AWS default credentials. backup.sh backs the bucket up as well.
BILLERY_FILES_STORE=local
BILLERY_FILES_S3_ENDPOINT=
BILLERY_FILES_S3_REGION=
BILLERY_FILES_S3_BUCKET=
BILLERY_FILES_S3_ACCESS_KEY=
BILLERY_FILES_S3_SECRET_KEY=
BILLERY_FILES_S3_PATH_STYLE=true
# Outgoing mail, used for invitations. Without MAIL_HOST, MAIL_FROM and BILLERY_PUBLIC_URL (the
# address users open, for example https://app.example.com) no mail is sent: invitations
# still work, the inviting user is told to inform the person. MAIL_SECURITY: starttls (default,
# port 587), ssl (port 465) or none. MAIL_PORT empty = the usual port of MAIL_SECURITY.
BILLERY_PUBLIC_URL=
# Emergency brake: invitation mails of the whole system in 24 hours. Reaching it logs an error.
BILLERY_INVITATION_MAILS_PER_DAY=1000
# Invitation mails from one source IP in 24 hours (0 = off).
BILLERY_INVITATION_MAILS_PER_IP=100
# Sign-up limits (docs/operations/saas-tenant-lifecycle.md): companies one user owns, companies
# created per user / per source IP / in the whole system in 24 hours. 0 switches one off.
BILLERY_MAX_COMPANIES_PER_USER=5
BILLERY_SIGNUPS_PER_USER_PER_DAY=3
BILLERY_SIGNUPS_PER_IP=10
BILLERY_SIGNUPS_PER_DAY=100
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# none refuses to start with a MAIL_USERNAME or MAIL_PASSWORD: the login would travel unencrypted.
MAIL_SECURITY=starttls

# Only for a frontend on ANOTHER origin. Empty = same origin (what this setup is).
CORS_ALLOWED_ORIGINS=

# --- Backups (./backup.sh, ./restore.sh; docs/operations/backup-restore.md) ----------------------
# Where the data is comes from the running stack. These settings decide what happens to the backup.
# Empty: it stays in ./backups on this server, not encrypted.
# BACKUP_DIR=
# KEEP=14
# Public key from `age-keygen` (age1...). Keep the private key OFF this server: without it no backup
# can be read, and whoever has it can read every backup.
BACKUP_AGE_RECIPIENT=
# S3-compatible storage for a copy off this server. Needs BACKUP_AGE_RECIPIENT.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=
# Delete copies older than this many days at the storage; 0 never deletes.
BACKUP_S3_KEEP_DAYS=30
# Called after every run, with /fail appended when it failed (a dead man's switch such as
# healthchecks.io also tells you when no run happens at all).
BACKUP_HEALTHCHECK_URL=
# check.sh warns when the last successful backup is older than this.
# BACKUP_MAX_AGE_HOURS=36

# --- Resources -------------------------------------------------------------------------------
# Memory and CPU of the containers. The Java heap takes 75 % of BACKEND_MEMORY_LIMIT. A full GoBD
# export of about 1 400 documents needed about 350 MB in total.
# BACKEND_MEMORY_LIMIT=1g
# BACKEND_CPUS=2
# DB_MEMORY_LIMIT=512m

# --- Metrics -----------------------------------------------------------------------------------
# Prometheus metrics at http://<backend container>:<port>/prometheus, reachable only from containers
# on the stack's network (the port is not published). Empty = off. Alert rules and an example
# scrape config: deploy/saas/monitoring/.
# BILLERY_METRICS_PORT=9464

# --- Request limits per tenant (429 above them) --------------------------------------------------
# BILLERY_LIMITS_REQUESTS_PER_SECOND=20
# BILLERY_LIMITS_BURST=200
# BILLERY_LIMITS_HEAVY_PER_TENANT=2
