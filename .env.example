# Copy to .env (next to docker-compose.yml) and configure the required database secret.
# Production Compose fails closed when DB_PASSWORD is missing or empty.

# --- Database ---------------------------------------------------------------
# Required for the root (production-layout) Compose stack. Use a secret manager or a
# securely permissioned .env file; never use the development password from backend/.
DB_PASSWORD=

# --- Network: one origin, reverse proxy in front ----------------------------
# The backend image serves the SPA and the API on port 8080. Point your reverse proxy at it:
#   same host:            reverse_proxy 127.0.0.1:8080
#   proxy in a container: reverse_proxy billery-backend:8080   (same compose network)
# Example Caddyfile / nginx config: docs/operations/deployment.md, deploy/Caddyfile.example.
# The proxy MUST send X-Forwarded-Proto / X-Forwarded-Host (Caddy and Traefik do by default).

# Host interface and port the backend is published on. Loopback = only the proxy can reach it
# (recommended: the app has no login). 0.0.0.0 = every interface (LAN demo, no proxy).
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# --- CORS (normally leave EMPTY) ---------------------------------------------
# Only for a frontend served from ANOTHER origin than the API, e.g. https://app.example.com
# (comma-separated, no path, no wildcard). Empty = same origin only.
CORS_ALLOWED_ORIGINS=

# --- Optional split mode: SPA in its own container (docker compose --profile split up) -----
# Empty = the SPA calls the host it was loaded from. Rebuild the image after changing it.
# VITE_API_BASE_URL=
# FRONTEND_PORT=5173

# --- Backups: ./deploy/saas/backup.sh --config .env ---------------------------
# See docs/operations/backup-restore.md and the BACKUP_* list in deploy/saas/.env.example. Without
# further settings the backup stays in ./backups on this machine, not encrypted.
BACKUP_BACKEND_CONTAINER=billery-backend

# --- Resources -------------------------------------------------------------------------------
# Memory and CPU of the containers. The Java heap takes 75 % of BACKEND_MEMORY_LIMIT. A full GoBD
# export of about 1 400 documents needed about 350 MB in total.
# BACKEND_MEMORY_LIMIT=1g
# BACKEND_CPUS=2
# DB_MEMORY_LIMIT=512m

# --- Metrics -----------------------------------------------------------------------------------
# Prometheus metrics at http://<backend container>:<port>/prometheus, reachable only from containers
# on the stack's network (the port is not published). Empty = off. Alert rules and an example
# scrape config: deploy/saas/monitoring/.
# BILLERY_METRICS_PORT=9464
